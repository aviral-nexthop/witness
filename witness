#!/usr/bin/env python3
"""witness — record a switch debugging session, then export the steps that mattered.

Two halves, joined by one file:

    capture   a ``rec>`` REPL that runs each command for you over ``nh tb ssh``,
              snapshots the interesting DB keys before and after, and appends
              events to ``events.jsonl``.
    curate    a reader/pruner/renderer that turns ``events.jsonl`` into a repro
              timeline you can paste into a ticket.

Nothing imports anything else: ``events.jsonl`` is the whole interface, so the
curate side runs off a fixture file and never needs a testbed.

Usage:
    witness start <testbed> [--nos sonic]     # record a session
    witness trim [SESSION]                    # keep/drop curation pass
    witness export [SESSION] [--paste]        # markdown timeline / wastebin URL
    witness demo [SESSION]                    # replay a recording, no network
    witness show [SESSION]                    # one line per recorded step

SESSION is a session directory, an events.jsonl path, or omitted for the most
recent recording under ~/.cmdrec.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

# Snapshotting whole DBs is slow and noisy; these are the keys the demo touches.
KEY_ALLOWLIST: tuple[tuple[str, str], ...] = (
    ("CONFIG_DB", "PORT|*"),
    ("APPL_DB", "PORT_TABLE:*"),
    ("STATE_DB", "PORT_TABLE|*"),
)

# Fixed settle window. SPINE uses keyspace notifications to close this adaptively;
# in a demo the two are indistinguishable.
SETTLE_SECONDS = 1.5

SSH_TIMEOUT = 120
SNAPSHOT_TIMEOUT = 60
SNAPSHOT_MARKER = "###CMDREC "

SESSIONS_ROOT = Path(os.environ.get("CMDREC_HOME", Path.home() / ".cmdrec"))

REDACTIONS: tuple[tuple[re.Pattern[str], str], ...] = (
    (re.compile(r"(?i)\b(password|passwd|pwd|secret|token|api[-_]?key)(\s*[:=]\s*|\s+)(\S+)"), r"\1\2<redacted>"),
    (re.compile(r"(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]{8,}"), r"\1 <redacted>"),
    (re.compile(r"(?<=\s)-p\s*\S+"), "-p <redacted>"),
    (re.compile(r"(?i)\bsshpass\s+-p\s*\S+"), "sshpass -p <redacted>"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S), "<redacted key>"),
)

# Commands that only read. A read is worth keeping when it corroborates a change,
# never on its own.
READ_ONLY_PREFIXES = (
    "show",
    "get",
    "cat",
    "ls",
    "less",
    "head",
    "tail",
    "grep",
    "ps",
    "ip ",
    "ifconfig",
    "netstat",
    "docker ps",
    "redis-cli",
    "sonic-db-dump",
    "uname",
    "date",
    "df",
    "dmesg",
)

MAX_DIFF_ROWS = 20

NOS_LABELS = {"sonic": "SONiC", "fboss": "FBOSS", "frr": "FRR", "linux": "Linux"}


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def redact(text: str) -> str:
    for pattern, replacement in REDACTIONS:
        text = pattern.sub(replacement, text)
    return text


def is_read_only(cmd: str) -> bool:
    stripped = cmd.strip().removeprefix("sudo ").strip()
    return any(stripped.startswith(prefix) for prefix in READ_ONLY_PREFIXES)


def port_object(key: str) -> str | None:
    """``PORT|Ethernet24``, ``PORT_TABLE:Ethernet24`` and ``PORT_TABLE|Ethernet24`` all
    name the same port. Everything downstream keys off that shared token."""
    for sep in ("|", ":"):
        if sep in key:
            table, _, rest = key.partition(sep)
            if table in ("PORT", "PORT_TABLE"):
                return rest
    return None


