@dataclass
class RunResult:
    out: str
    exit_code: int
    ms: int


def _set_winsize(fd: int, rows: int = PTY_ROWS, cols: int = PTY_COLS) -> None:
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


class Switch:
    """One ``nh tb ssh`` login for the whole recording.

    A background thread drains the PTY so a large dump cannot stall the
    session. Commands are delimited by a unique marker. A timeout sends
    Ctrl-C and resyncs the same login instead of opening a new one.
    """

    def __init__(self, spec: str, nos: str | None = None) -> None:
        self.spec = spec
        self.nos = nos
        self._proc: subprocess.Popen[bytes] | None = None
        self._master: int | None = None
        self._lines: queue.Queue[str] = queue.Queue()
        self._reader: threading.Thread | None = None
        self._reader_stop = threading.Event()

    def _login_argv(self) -> list[str]:
        argv = ["nh", "tb", "ssh"]
        if self.nos:
            argv += ["--nos", self.nos]
        return argv + [self.spec]

    def _alive(self) -> bool:
        return self._proc is not None and self._proc.poll() is None and self._master is not None

    def close(self) -> None:
        self._reader_stop.set()
        proc, master, reader = self._proc, self._master, self._reader
        self._proc = None
        self._master = None
        self._reader = None
        if master is not None:
            try:
                os.write(master, b"exit\n")
            except OSError:
                pass
            try:
                os.close(master)
            except OSError:
                pass
        if reader is not None:
            reader.join(timeout=1)
        if proc is not None:
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        self._drain(0)

    def connect(self) -> None:
        if self._alive():
            return
        self.close()
        self._reader_stop.clear()
        self._lines = queue.Queue()
        master, slave = pty.openpty()
        try:
            _set_winsize(slave)
            self._proc = subprocess.Popen(
                self._login_argv(),
                stdin=slave,
                stdout=slave,
                stderr=slave,
                close_fds=True,
                start_new_session=True,
            )
        except FileNotFoundError:
            os.close(master)
            os.close(slave)
            raise
        os.close(slave)
        self._master = master
        self._reader = threading.Thread(target=self._reader_loop, name="witness-ssh", daemon=True)
        self._reader.start()
        try:
            if not self._alive():
                raise ConnectionError(self._scraped() or "nh tb ssh exited during login")
            # Handshake retries until a shell answers. nh's password prompt is
            # on pexpect's own pty; bytes we send queue until interact() starts.
            self._handshake()
        except (TimeoutError, ConnectionError, OSError):
            err = self._scraped()
            self.close()
            raise ConnectionError(err or "ssh session failed") from None

    def run(self, command: str, timeout: int = SSH_TIMEOUT) -> RunResult:
        started = time.monotonic()
        marker = DONE_PREFIX + secrets.token_hex(8)
        quoted = shlex.quote(force_sudo_n(command))
        cap = max(1, int(timeout) - 2)
        # One line: SONiC ``config`` reads /dev/tty and swallows a following
        # printf if we send it as a second PTY line — that was the 120s hang
        # (the change still applied). setsid drops the controlling TTY; timeout
        # guarantees the printf still runs if the command wedges.
        script = (
            f"if command -v setsid >/dev/null 2>&1; then "
            f"timeout {cap} setsid -w sh -c {quoted} </dev/null; "
            f"else timeout {cap} sh -c {quoted} </dev/null; fi; "
            f"printf '%s %d\\n' {shlex.quote(marker)} $?"
        )
        try:
            return self._transact(script, marker, timeout, started)
        except FileNotFoundError:
            return RunResult(out="witness: `nh` not found on PATH", exit_code=127, ms=_elapsed_ms(started))

    def run_tracked(self, command: str, patterns: list[tuple[str, str]], timeout: int = WRITE_TIMEOUT) -> tuple[RunResult, Snapshot, Snapshot]:
        """Dump, run the write, settle, dump — three small commands on the same login."""
        started = time.monotonic()
        empty: Snapshot = {db: {} for db, _ in KEY_ALLOWLIST}
        before = self._snapshot_keys(patterns)
        result = self.run(command, timeout=timeout)
        if result.exit_code in (124, 127, 255):
            return RunResult(result.out, result.exit_code, _elapsed_ms(started)), before, empty
        time.sleep(SETTLE_SECONDS)
        after = self._snapshot_keys(patterns)
        return RunResult(result.out, result.exit_code, _elapsed_ms(started)), before, after

    def _snapshot_keys(self, patterns: list[tuple[str, str]]) -> Snapshot:
        empty: Snapshot = {db: {} for db, _ in KEY_ALLOWLIST}
        if not patterns:
            return empty
        result = self.run(self._dump_script(patterns), timeout=DUMP_TIMEOUT)
        if not result.out:
            return empty
        return self._parse_snapshot(result.out)

    def environment(self) -> dict[str, str]:
        """Build, platform and NOS version, captured once so the timeline has a header."""
        env = {"testbed": self.spec, "nos": self.nos or "sonic"}
        result = self.run("show version", timeout=SNAPSHOT_TIMEOUT)
        if result.exit_code == 0:
            for line in result.out.splitlines():
                if ":" not in line:
                    continue
                label, _, value = line.partition(":")
                label, value = label.strip().lower(), value.strip()
                if label.startswith("sonic software version"):
                    env["version"] = value.removeprefix("SONiC.")
                elif label == "platform":
                    env["platform"] = value
                elif label == "hwsku":
                    env["hwsku"] = value
        else:  # FBOSS and friends have no `show version`
            uname = self.run("uname -srm", timeout=SNAPSHOT_TIMEOUT)
            if uname.exit_code == 0:
                env["version"] = uname.out.strip()
        return env

    def _transact(self, script: str, marker: str, timeout: float, started: float) -> RunResult:
        try:
            if not self._alive():
                self.connect()
        except FileNotFoundError:
            raise
        except (ConnectionError, OSError) as exc:
            return RunResult(out=f"witness: {exc}", exit_code=255, ms=_elapsed_ms(started))
        try:
            self._send(script.rstrip() + "\n")
            lines, trailer = self._read_until(
                lambda line: line == marker or line.startswith(marker + " "),
                timeout=timeout,
            )
        except TimeoutError:
            self._recover_after_timeout()
            return RunResult(out=f"witness: timed out after {timeout}s", exit_code=124, ms=_elapsed_ms(started))
        except (ConnectionError, OSError) as exc:
            self.close()
            return RunResult(out=f"witness: ssh session closed: {exc}", exit_code=255, ms=_elapsed_ms(started))
        rest = trailer[len(marker) :].strip()
        try:
            code = int(rest)
        except ValueError:
            code = 0
        return RunResult(out="\n".join(lines).rstrip("\n"), exit_code=code, ms=_elapsed_ms(started))

    def _handshake(self) -> None:
        ready = READY_PREFIX + secrets.token_hex(8)
        # Stay in the login shell — `exec bash --noprofile` would drop PATH.
        handshake = (
            f"stty -echo cols {PTY_COLS} rows {PTY_ROWS} 2>/dev/null; "
            f"PS1=; export PS1; printf '%s\\n' {shlex.quote(ready)}\n"
        )
        deadline = time.monotonic() + SSH_TIMEOUT
        self._send(handshake)
        while True:
            if not self._alive():
                raise ConnectionError(self._scraped() or "remote shell closed")
            try:
                self._read_until(lambda line: line == ready, timeout=2.5)
                self._drain(0.1)
                return
            except TimeoutError:
                if time.monotonic() >= deadline:
                    raise
                self._send(handshake)

    def _recover_after_timeout(self) -> None:
        """Keep the login. Interrupt the wedged command and re-handshake."""
        if not self._alive():
            self.close()
            return
        try:
            self._send("\x03")
            self._drain(0.2)
            self._handshake()
        except (TimeoutError, ConnectionError, OSError):
            self.close()

    def _send(self, text: str) -> None:
        if self._master is None:
            raise ConnectionError("no ssh session")
        os.write(self._master, text.encode())

    def _reader_loop(self) -> None:
        buf = bytearray()
        while not self._reader_stop.is_set():
            master = self._master
            if master is None:
                break
            if self._proc is not None and self._proc.poll() is not None:
                break
            try:
                ready, _, _ = select.select([master], [], [], 0.2)
            except OSError:
                break
            if not ready:
                continue
            try:
                chunk = os.read(master, 8192)
            except OSError:
                break
            if not chunk:
                break
            buf.extend(chunk)
            while True:
                nl = buf.find(b"\n")
                if nl < 0:
                    break
                raw = bytes(buf[:nl])
                del buf[: nl + 1]
                self._lines.put(raw.decode("utf-8", errors="replace").rstrip("\r"))

    def _drain(self, seconds: float) -> None:
        end = time.monotonic() + seconds
        while True:
            remaining = end - time.monotonic()
            try:
                if remaining <= 0:
                    self._lines.get_nowait()
                else:
                    self._lines.get(timeout=remaining)
            except queue.Empty:
                return

    def _scraped(self) -> str:
        bits: list[str] = []
        while True:
            try:
                bits.append(self._lines.get_nowait())
            except queue.Empty:
                return "\n".join(bits)

    def _read_until(self, matches: Callable[[str], bool], timeout: float) -> tuple[list[str], str]:
        lines: list[str] = []
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError
            if self._proc is not None and self._proc.poll() is not None and self._lines.empty():
                raise ConnectionError(self._scraped() or "ssh session closed")
            try:
                line = self._lines.get(timeout=remaining)
            except queue.Empty:
                raise TimeoutError
            if matches(line):
                return lines, line
            lines.append(line)

    @staticmethod
    def _dump_script(patterns: list[tuple[str, str]]) -> str:
        parts: list[str] = []
        for db, pattern in patterns:
            parts.append(f"echo {shlex.quote(SNAPSHOT_MARKER + db)}")
            parts.append(
                "timeout 8 sudo -n sonic-db-dump "
                f"-n {shlex.quote(db)} -k {shlex.quote(pattern)} -y 2>/dev/null || echo '{{}}'"
            )
        return "; ".join(parts)

    @staticmethod
    def _parse_snapshot(text: str) -> Snapshot:
        snapshot: Snapshot = {db: {} for db, _ in KEY_ALLOWLIST}
        current: str | None = None
        buffer: list[str] = []

        def flush() -> None:
            if current is None:
                return
            raw = "\n".join(buffer).strip()
            if not raw:
                return
            try:
                loaded = json.loads(raw)
            except json.JSONDecodeError:
                return
            bucket = snapshot.setdefault(current, {})
            for key, entry in loaded.items():
                value = entry.get("value", entry) if isinstance(entry, dict) else {}
                if isinstance(value, dict):
                    bucket[key] = {str(k): str(v) for k, v in value.items()}

        for line in text.splitlines():
            if line.startswith(SNAPSHOT_MARKER):
                flush()
                current, buffer = line[len(SNAPSHOT_MARKER) :].strip(), []
            elif current is not None:
                buffer.append(line)
        flush()
        return snapshot


def _elapsed_ms(started: float) -> int:
    return int((time.monotonic() - started) * 1000)


Snapshot = dict[str, dict[str, dict[str, str]]]
Change = list[str]  # [db, key, field, before, after]


def diff_snapshots(before: Snapshot, after: Snapshot) -> list[Change]:
    changes: list[Change] = []
    for db, _ in KEY_ALLOWLIST:
        keys = sorted(set(before.get(db, {})) | set(after.get(db, {})))
        for key in keys:
            fields_before = before.get(db, {}).get(key, {})
            fields_after = after.get(db, {}).get(key, {})
            for field_name in sorted(set(fields_before) | set(fields_after)):
                old = fields_before.get(field_name, "")
                new = fields_after.get(field_name, "")
                if old != new:
                    changes.append([db, key, field_name, old, new])
    return changes


def add_witness_rows(changes: list[Change], before: Snapshot, after: Snapshot) -> list[Change]:
    """The bug is a *non*-change, so a plain diff hides it.

    Whenever a port's admin_status moved, carry its STATE_DB oper_status into the
    diff even when it stayed put — that unchanged row is the evidence.
    """
    touched = {port_object(c[1]) for c in changes if c[2] == "admin_status"}
    touched.discard(None)
    already = {(c[1], c[2]) for c in changes}
    for port in sorted(p for p in touched if p):
        key = f"PORT_TABLE|{port}"
        if (key, "oper_status") in already:
            continue
        old = before.get("STATE_DB", {}).get(key, {}).get("oper_status", "")
        new = after.get("STATE_DB", {}).get(key, {}).get("oper_status", "")
        if old or new:
            changes.append(["STATE_DB", key, "oper_status", old, new])
    return changes


def detect_anomaly(changes: list[Change]) -> str | None:
    """The one rule we ship: admin_status moved, oper_status didn't follow."""
    ports = {port_object(c[1]) for c in changes if c[2] == "admin_status"}
    for port in sorted(p for p in ports if p):
        admin_moved = any(c[2] == "admin_status" and c[3] != c[4] and port_object(c[1]) == port for c in changes)
        if not admin_moved:
            continue
        oper_rows = [c for c in changes if c[2] == "oper_status" and port_object(c[1]) == port]
        if oper_rows and all(c[3] == c[4] for c in oper_rows):
            return "oper_status did not follow admin_status"
    return None


class Recorder:
    def __init__(self, session_dir: Path, switch: Switch) -> None:
        self.dir = session_dir
        self.switch = switch
        self.events_path = session_dir / "events.jsonl"
        self.seq = 0
        self.last_command_seq = 0

    def _append(self, event: dict[str, object]) -> int:
        self.seq += 1
        event["seq"] = self.seq
        with self.events_path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, sort_keys=False) + "\n")
        return self.seq

    def start(self) -> None:
        self.dir.mkdir(parents=True, exist_ok=True)
        print(f"connecting {self.switch.spec} …", flush=True)
        try:
            self.switch.connect()
        except FileNotFoundError:
            sys.exit("witness: `nh` not found on PATH")
        except (ConnectionError, OSError) as exc:
            sys.exit(f"witness: {exc}")
        env = self.switch.environment()
        self._append({"event": "meta", "t": utcnow(), **env})
        nos = NOS_LABELS.get(env.get("nos", ""), env.get("nos", "").upper())
        version = f"{nos} {env['version']}".strip() if env.get("version") else nos
        label = " · ".join(v for v in (env.get("testbed"), version, env.get("platform")) if v)
        print(f"recording {label}")
        print(f"  → {self.events_path}")
        print("  commands run on the DUT; `mark <note>` flags a step, `stop` ends the recording.\n")

    def run_command(self, cmd: str) -> None:
        ports = extract_ports(cmd)
        if is_read_only(cmd) or not ports:
            result = self.switch.run(cmd)
            changes: list[Change] = []
        else:
            result, before, after = self.switch.run_tracked(cmd, snapshot_patterns(ports))
            changes = add_witness_rows(diff_snapshots(before, after), before, after)
        if result.out:
            print(result.out)
        seq = self._append(
            {
                "event": "command",
                "t": utcnow(),
                "nos": self.switch.nos or "sonic",
                "cmd": redact(cmd),
                "exit": result.exit_code,
                "ms": result.ms,
                "out": redact(result.out),
                "marked": False,
            }
        )
        self.last_command_seq = seq
        if not changes:
            return
        anomaly = detect_anomaly(changes)
        self._append({"event": "state_diff", "caused_by": seq, "changes": changes, "anomaly": anomaly})
        for change in changes[:MAX_DIFF_ROWS]:
            print(f"  {format_change(change)}")
        if anomaly:
            print(f"  ⚠ {anomaly}")

    def mark(self, note: str) -> None:
        if not self.last_command_seq:
            print("  nothing to mark yet")
            return
        self._append({"event": "marker", "t": utcnow(), "about": self.last_command_seq, "note": note})
        print(f"  ◀ marked: {note}" if note else "  ◀ marked")

    def repl(self) -> None:
        try:
            import readline  # noqa: F401  (line editing + history in the prompt)
        except ImportError:
            pass
        while True:
            try:
                line = input("rec> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            verb, _, rest = line.partition(" ")
            if verb in ("stop", "exit", "quit"):
                break
            if verb == "help":
                print("  mark <note>   flag the command that just ran\n  stop          end the recording")
                continue
            if verb == "mark":
                self.mark(rest.strip().strip('"'))
                continue
            self.run_command(line)
        print(f"\nrecorded {self.seq} events → {self.events_path}")
        print(f"next: witness trim {self.dir}")


