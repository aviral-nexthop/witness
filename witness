# capture
# --------------------------------------------------------------------------------------


@dataclass
class RunResult:
    out: str
    exit_code: int
    ms: int


class Switch:
    """Everything that needs a live box. One subprocess per command, no PTY."""

    def __init__(self, spec: str, nos: str | None = None) -> None:
        self.spec = spec
        self.nos = nos

    def _argv(self, command: str) -> list[str]:
        argv = ["nh", "tb", "ssh"]
        if self.nos:
            argv += ["--nos", self.nos]
        return argv + [self.spec, "-c", command]

    def run(self, command: str, timeout: int = SSH_TIMEOUT) -> RunResult:
        started = time.monotonic()
        try:
            proc = subprocess.run(
                self._argv(command),
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
            out = proc.stdout + (proc.stderr if proc.returncode else "")
            code = proc.returncode
        except subprocess.TimeoutExpired:
            out, code = f"witness: timed out after {timeout}s\n", 124
        except FileNotFoundError:
            out, code = "witness: `nh` not found on PATH\n", 127
        return RunResult(out=out.rstrip("\n"), exit_code=code, ms=int((time.monotonic() - started) * 1000))

    def environment(self) -> dict[str, str]:
        """Build, platform and NOS version, captured once so the timeline has a header."""
        env = {"testbed": self.spec, "nos": self.nos or "sonic"}
        result = self.run("show version", timeout=SNAPSHOT_TIMEOUT)
        if result.exit_code == 0:
            for line in result.out.splitlines():
                if ":" not in line:
                    continue
                label, _, value = line.partition(":")
                label, value = label.strip().lower(), value.strip()
                if label.startswith("sonic software version"):
                    env["version"] = value.removeprefix("SONiC.")
                elif label == "platform":
                    env["platform"] = value
                elif label == "hwsku":
                    env["hwsku"] = value
        else:  # FBOSS and friends have no `show version`
            uname = self.run("uname -srm", timeout=SNAPSHOT_TIMEOUT)
            if uname.exit_code == 0:
                env["version"] = uname.out.strip()
        return env

    def snapshot(self) -> dict[str, dict[str, dict[str, str]]]:
        """One SSH round trip for the whole allowlist: {db: {key: {field: value}}}."""
        parts: list[str] = []
        for db, pattern in KEY_ALLOWLIST:
            parts.append(f"echo {shlex.quote(SNAPSHOT_MARKER + db)}")
            dump = f"sudo sonic-db-dump -n {shlex.quote(db)} -k {shlex.quote(pattern)} -y"
            parts.append(f"{dump} 2>/dev/null || echo '{{}}'")
        result = self.run("; ".join(parts), timeout=SNAPSHOT_TIMEOUT)
        return self._parse_snapshot(result.out)

    @staticmethod
    def _parse_snapshot(text: str) -> dict[str, dict[str, dict[str, str]]]:
        snapshot: dict[str, dict[str, dict[str, str]]] = {db: {} for db, _ in KEY_ALLOWLIST}
        current: str | None = None
        buffer: list[str] = []

        def flush() -> None:
            if current is None:
                return
            raw = "\n".join(buffer).strip()
            if not raw:
                return
            try:
                loaded = json.loads(raw)
            except json.JSONDecodeError:
                return
            bucket = snapshot.setdefault(current, {})
            for key, entry in loaded.items():
                value = entry.get("value", entry) if isinstance(entry, dict) else {}
                if isinstance(value, dict):
                    bucket[key] = {str(k): str(v) for k, v in value.items()}

        for line in text.splitlines():
            if line.startswith(SNAPSHOT_MARKER):
                flush()
                current, buffer = line[len(SNAPSHOT_MARKER):].strip(), []
            elif current is not None:
                buffer.append(line)
        flush()
        return snapshot


Snapshot = dict[str, dict[str, dict[str, str]]]
Change = list[str]  # [db, key, field, before, after]


def diff_snapshots(before: Snapshot, after: Snapshot) -> list[Change]:
    changes: list[Change] = []
    for db, _ in KEY_ALLOWLIST:
        keys = sorted(set(before.get(db, {})) | set(after.get(db, {})))
        for key in keys:
            fields_before = before.get(db, {}).get(key, {})
            fields_after = after.get(db, {}).get(key, {})
            for field_name in sorted(set(fields_before) | set(fields_after)):
                old = fields_before.get(field_name, "")
                new = fields_after.get(field_name, "")
                if old != new:
                    changes.append([db, key, field_name, old, new])
    return changes


def add_witness_rows(changes: list[Change], before: Snapshot, after: Snapshot) -> list[Change]:
    """The bug is a *non*-change, so a plain diff hides it.

    Whenever a port's admin_status moved, carry its STATE_DB oper_status into the
    diff even when it stayed put — that unchanged row is the evidence.
    """
    touched = {port_object(c[1]) for c in changes if c[2] == "admin_status"}
    touched.discard(None)
    already = {(c[1], c[2]) for c in changes}
    for port in sorted(p for p in touched if p):
        key = f"PORT_TABLE|{port}"
        if (key, "oper_status") in already:
            continue
        old = before.get("STATE_DB", {}).get(key, {}).get("oper_status", "")
        new = after.get("STATE_DB", {}).get(key, {}).get("oper_status", "")
        if old or new:
            changes.append(["STATE_DB", key, "oper_status", old, new])
    return changes


def detect_anomaly(changes: list[Change]) -> str | None:
    """The one rule we ship: admin_status moved, oper_status didn't follow."""
    ports = {port_object(c[1]) for c in changes if c[2] == "admin_status"}
    for port in sorted(p for p in ports if p):
        admin_moved = any(c[2] == "admin_status" and c[3] != c[4] and port_object(c[1]) == port for c in changes)
        if not admin_moved:
            continue
        oper_rows = [c for c in changes if c[2] == "oper_status" and port_object(c[1]) == port]
        if oper_rows and all(c[3] == c[4] for c in oper_rows):
            return "oper_status did not follow admin_status"
    return None


class Recorder:
    def __init__(self, session_dir: Path, switch: Switch) -> None:
        self.dir = session_dir
        self.switch = switch
        self.events_path = session_dir / "events.jsonl"
        self.seq = 0
        self.last_command_seq = 0

    def _append(self, event: dict[str, object]) -> int:
        self.seq += 1
        event["seq"] = self.seq
        with self.events_path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, sort_keys=False) + "\n")
        return self.seq

    def start(self) -> None:
        self.dir.mkdir(parents=True, exist_ok=True)
        env = self.switch.environment()
        self._append({"event": "meta", "t": utcnow(), **env})
        nos = NOS_LABELS.get(env.get("nos", ""), env.get("nos", "").upper())
        version = f"{nos} {env['version']}".strip() if env.get("version") else nos
        label = " · ".join(v for v in (env.get("testbed"), version, env.get("platform")) if v)
        print(f"recording {label}")
        print(f"  → {self.events_path}")
        print("  commands run on the DUT; `mark <note>` flags a step, `stop` ends the recording.\n")

    def run_command(self, cmd: str) -> None:
        before = self.switch.snapshot()
        result = self.switch.run(cmd)
        if result.out:
            print(result.out)
        seq = self._append(
            {
                "event": "command",
                "t": utcnow(),
                "nos": self.switch.nos or "sonic",
                "cmd": redact(cmd),
                "exit": result.exit_code,
                "ms": result.ms,
                "out": redact(result.out),
                "marked": False,
            }
        )
        self.last_command_seq = seq
        time.sleep(SETTLE_SECONDS)
        after = self.switch.snapshot()
        changes = add_witness_rows(diff_snapshots(before, after), before, after)
        if not changes:
            return
        anomaly = detect_anomaly(changes)
        self._append({"event": "state_diff", "caused_by": seq, "changes": changes, "anomaly": anomaly})
        for change in changes[:MAX_DIFF_ROWS]:
            print(f"  {format_change(change)}")
        if anomaly:
            print(f"  ⚠ {anomaly}")

    def mark(self, note: str) -> None:
        if not self.last_command_seq:
            print("  nothing to mark yet")
            return
        self._append({"event": "marker", "t": utcnow(), "about": self.last_command_seq, "note": note})
        print(f"  ◀ marked: {note}" if note else "  ◀ marked")

    def repl(self) -> None:
        try:
            import readline  # noqa: F401  (line editing + history in the prompt)
        except ImportError:
            pass
        while True:
            try:
                line = input("rec> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            verb, _, rest = line.partition(" ")
            if verb in ("stop", "exit", "quit"):
                break
            if verb == "help":
                print("  mark <note>   flag the command that just ran\n  stop          end the recording")
                continue
            if verb == "mark":
                self.mark(rest.strip().strip('"'))
                continue
            self.run_command(line)
        print(f"\nrecorded {self.seq} events → {self.events_path}")
        print(f"next: witness trim {self.dir}")


# --------------------------------------------------------------------------------------
# curate — reads events.jsonl and nothing else
# --------------------------------------------------------------------------------------


@dataclass
class Step:
    seq: int
    t: str
    cmd: str
    exit_code: int
    ms: int
    out: str
    marked: bool = False
    note: str | None = None
    changes: list[Change] = field(default_factory=list)
    anomaly: str | None = None

    @property
    def seconds(self) -> str:
        return f"{self.ms / 1000:.1f}s"


@dataclass
class Session:
    path: Path
    meta: dict[str, str]
    steps: list[Step]

    @property
    def dir(self) -> Path:
        return self.path.parent

    def recorded_at(self) -> str:
        stamp = self.meta.get("t") or (self.steps[0].t if self.steps else utcnow())
        try:
            return datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").strftime("%Y-%m-%d %H:%M UTC")
        except ValueError:
            return stamp

    def header(self) -> str:
        bits = [self.meta.get("testbed", "unknown testbed")]
        nos = NOS_LABELS.get(self.meta.get("nos", ""), self.meta.get("nos", "").upper() or "SONiC")
        version = self.meta.get("version")
        bits.append(f"{nos} {version}" if version else nos)
        if self.meta.get("platform"):
            bits.append(self.meta["platform"])
        return " · ".join(bits)


def load_session(path: Path) -> Session:
    """Tolerates a truncated last line — a recording killed mid-write still loads."""
    meta: dict[str, str] = {}
    steps: list[Step] = []
    by_seq: dict[int, Step] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        kind = event.get("event")
        if kind == "meta":
            meta = {k: str(v) for k, v in event.items() if k not in ("event", "seq", "t")}
            meta.setdefault("t", str(event.get("t", "")))
        elif kind == "command":
            step = Step(
                seq=int(event.get("seq", len(steps) + 1)),
                t=str(event.get("t", "")),
                cmd=str(event.get("cmd", "")),
                exit_code=int(event.get("exit", 0)),
                ms=int(event.get("ms", 0)),
                out=str(event.get("out", "")),
                marked=bool(event.get("marked", False)),
            )
            steps.append(step)
            by_seq[step.seq] = step
        elif kind == "state_diff":
            target = by_seq.get(int(event.get("caused_by", -1)))
            if target is not None:
                target.changes = [list(map(str, c)) for c in event.get("changes", [])]
                target.anomaly = event.get("anomaly") or None
        elif kind == "marker":
            about = int(event.get("about", steps[-1].seq if steps else -1))
            target = by_seq.get(about)
            if target is not None:
                target.marked = True
                target.note = event.get("note") or target.note
    return Session(path=path, meta=meta, steps=steps)


def prune(steps: list[Step]) -> list[Step]:
    """41 steps of debugging, 6 of which are the repro.

    Keep anything that changed state, anything the engineer marked, and the reads
    that immediately corroborate one of those. Drop typos, dead-end reads and
    consecutive repeats.
    """
    deduped: list[Step] = []
    for step in steps:
        if deduped and deduped[-1].cmd == step.cmd and not step.marked and not step.changes:
            deduped[-1] = step  # consecutive repeat: the last one is the one that counts
            continue
        deduped.append(step)

    kept: list[Step] = []
    previous_changed = False
    for step in deduped:
        changed = bool(step.marked or step.changes or step.anomaly)
        keep = changed
        if not keep and step.exit_code == 0 and is_read_only(step.cmd) and previous_changed:
            keep = True  # the read that verifies the change we just kept — but only the first one
        if keep:
            kept.append(step)
        previous_changed = changed
    return kept


def read_keep_spec(spec: str, available: list[int]) -> set[int] | None:
    """``1-3,7`` keeps those steps; ``drop 4`` removes them from the current set."""
    spec = spec.strip().lower()
    if not spec:
        return None
    if spec in ("all", "reset"):
        return set(available)
    dropping = spec.startswith("drop")
    if dropping:
        spec = spec[4:]
    picked: set[int] = set()
    for token in spec.replace(" ", ",").split(","):
        if not token:
            continue
        if "-" in token.strip("-"):
            lo, _, hi = token.partition("-")
            try:
                picked.update(range(int(lo), int(hi) + 1))
            except ValueError:
                return None
        else:
            try:
                picked.add(int(token))
            except ValueError:
                return None
    return {-n for n in picked} if dropping else picked


# --------------------------------------------------------------------------------------
# render
# --------------------------------------------------------------------------------------


def format_change(change: Change, width: tuple[int, int, int] = (9, 26, 14)) -> str:
    db, key, field_name, old, new = change
    arrow = f"{old or '∅'} → {new or '∅'}"
    row = f"{db:<{width[0]}} {key:<{width[1]}} {field_name:<{width[2]}} {arrow}"
    if old == new and field_name == "oper_status":
        row += "   ⚠ did not follow"
    return row.rstrip()


def render_markdown(session: Session, steps: list[Step], total: int) -> str:
    lines = [
        f"## Reproduction — recorded {session.recorded_at()}",
        f"## {session.header()}",
        f"## {len(steps)} of {total} recorded steps kept",
        "",
        "```",
    ]
    widths = (9, 26, 14)
    for number, step in enumerate(steps, start=1):
        suffix = "  ◀ marked" if step.marked else ""
        if step.note:
            suffix = f"  ◀ {step.note}"
        lines.append(f"{number:>2}. {step.cmd:<52} {step.seconds:>6}  exit {step.exit_code}{suffix}")
        for change in step.changes[:MAX_DIFF_ROWS]:
            lines.append(f"      {format_change(change, widths)}")
        if len(step.changes) > MAX_DIFF_ROWS:
            lines.append(f"      … {len(step.changes) - MAX_DIFF_ROWS} more rows")
        if step.anomaly:
            lines.append(f"      ⚠ {step.anomaly}")
    lines.append("```")
    flagged = [f"step {i + 1}: {s.anomaly}" for i, s in enumerate(steps) if s.anomaly]
    if flagged:
        lines += ["", "**Anomaly:** " + "; ".join(flagged)]
    return "\n".join(lines) + "\n"


def render_script(session: Session, steps: list[Step]) -> str:
    lines = [
        "#!/bin/bash",
        f"# Repro for {session.header()} — generated by witness",
        "set -x",
        "",
    ]
    for step in steps:
        if step.note:
            lines.append(f"# {step.note}")
        lines.append(step.cmd)
        if step.changes:
            lines.append("sleep 2")
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------------------
# session resolution + commands
# --------------------------------------------------------------------------------------


def resolve_session(target: str | None) -> Path:
    if target:
        path = Path(target).expanduser()
        if path.is_dir():
            return path / "events.jsonl"
        return path
    candidates = sorted(SESSIONS_ROOT.glob("*/events.jsonl"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        sys.exit(f"witness: no recordings under {SESSIONS_ROOT}; pass a session path or run `witness start`")
    return candidates[-1]


def curated_steps(session: Session) -> list[Step]:
    """The trim list if there is one, otherwise the automatic pruning."""
    curated = session.dir / "curated.json"
    if curated.exists():
        keep = set(json.loads(curated.read_text(encoding="utf-8")).get("keep", []))
        chosen = [s for s in session.steps if s.seq in keep]
        if chosen:
            return chosen
    return prune(session.steps)


def cmd_start(args: argparse.Namespace) -> int:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    session_dir = Path(args.dir).expanduser() if args.dir else SESSIONS_ROOT / f"{args.testbed}-{stamp}"
    recorder = Recorder(session_dir, Switch(args.testbed, args.nos))
    recorder.start()
    recorder.repl()
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    session = load_session(resolve_session(args.session))
    keep = {s.seq for s in curated_steps(session)}
    print(session.header())
    for step in session.steps:
        flag = "keep" if step.seq in keep else "    "
        mark = "◀" if step.marked else " "
        print(f"{flag} {step.seq:>3} {mark} {step.cmd:<56} {step.seconds:>6} exit {step.exit_code}")
    print(f"\n{len(keep)} of {len(session.steps)} steps kept")
    return 0


def cmd_trim(args: argparse.Namespace) -> int:
    path = resolve_session(args.session)
    session = load_session(path)
    if not session.steps:
        sys.exit("witness: no command events in this recording")
    keep = {s.seq for s in curated_steps(session)}
    available = [s.seq for s in session.steps]
    print(f"{session.header()}\n")
    while True:
        for step in session.steps:
            box = "[x]" if step.seq in keep else "[ ]"
            note = f"  ◀ {step.note}" if step.note else ("  ◀ marked" if step.marked else "")
            diff = f"  ({len(step.changes)} changes)" if step.changes else ""
            print(f"{box} {step.seq:>3}. {step.cmd:<52}{diff}{note}")
        print(f"\n{len(keep)} kept. Enter a keep list (`1-3,7`), `drop 4`, `all`, or blank to save.")
        try:
            spec = input("keep> ")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not spec.strip():
            break
        picked = read_keep_spec(spec, available)
        if picked is None:
            print("witness: could not parse that list\n")
            continue
        if any(n < 0 for n in picked):
            keep -= {-n for n in picked}
        else:
            keep = {n for n in picked if n in available}
        print()
    curated = session.dir / "curated.json"
    curated.write_text(json.dumps({"keep": sorted(keep)}, indent=2) + "\n", encoding="utf-8")
    print(f"saved {len(keep)} steps → {curated}  (events.jsonl untouched)")
    return 0


def cmd_export(args: argparse.Namespace) -> int:
    session = load_session(resolve_session(args.session))
    steps = curated_steps(session)
    markdown = render_markdown(session, steps, len(session.steps))
    if args.sh:
        Path(args.sh).write_text(render_script(session, steps), encoding="utf-8")
        os.chmod(args.sh, 0o755)
        print(f"wrote {args.sh}", file=sys.stderr)
    if args.paste:
        title = f"repro {session.meta.get('testbed', 'session')}"
        proc = subprocess.run(
            ["nh", "paste", "--ext", "md", "-t", title],
            input=markdown,
            capture_output=True,
            text=True,
            check=False,
        )
        if proc.returncode:
            sys.exit(f"witness: nh paste failed: {proc.stderr.strip()}")
        print(proc.stdout.strip())
        return 0
    sys.stdout.write(markdown)
    return 0


def cmd_demo(args: argparse.Namespace) -> int:
    """Replay a recording with no network at all. The insurance policy."""
    session = load_session(resolve_session(args.session))
    steps = curated_steps(session)
    print(f"recording {session.header()}  (replay)\n")
    for step in steps:
        print(f"rec> {step.cmd}")
        time.sleep(args.speed)
        if step.out:
            print(step.out)
        for change in step.changes[:MAX_DIFF_ROWS]:
            print(f"  {format_change(change)}")
        if step.anomaly:
            print(f"  ⚠ {step.anomaly}")
        if step.note:
            print(f"  ◀ marked: {step.note}")
        print()
    print(f"rec> stop\n\n{len(steps)} of {len(session.steps)} steps kept")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="witness",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    start = sub.add_parser("start", help="record a session against a testbed")
    start.add_argument("testbed", help="testbed spec, e.g. vtb-aviral-01 or gold101-dut")
    start.add_argument("--nos", choices=("sonic", "fboss", "frr", "linux"), default="sonic")
    start.add_argument("--dir", help="session directory (default: ~/.cmdrec/<testbed>-<stamp>)")
    start.set_defaults(func=cmd_start)

    for name, help_text, func in (
        ("show", "list recorded steps and what pruning keeps", cmd_show),
        ("trim", "interactively keep/drop steps", cmd_trim),
        ("demo", "replay a recording with no network", cmd_demo),
        ("export", "render the repro timeline", cmd_export),
    ):
        node = sub.add_parser(name, help=help_text)
        node.add_argument("session", nargs="?", help="session dir or events.jsonl (default: latest)")
        node.set_defaults(func=func)
        if name == "demo":
            node.add_argument("--speed", type=float, default=0.6, help="seconds between steps")
        if name == "export":
            node.add_argument("--paste", action="store_true", help="upload via `nh paste` and print the URL")
            node.add_argument("--sh", metavar="PATH", help="also write a repro.sh")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
